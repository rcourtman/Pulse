{
  "schema_version": "patrol.qual/v1",
  "id": "response.pve-guest-died",
  "version": 4,
  "title": "container died by itself",
  "description": "The gitea container's init is killed from outside. The container is down and the node logged no stop or shutdown task, so nobody stopped it. Starting it fixes it.",
  "owner": "ai-runtime",
  "track": "response",
  "risk": "reversible",
  "tags": [
    "proxmox",
    "response",
    "fault-set-pve-v1",
    "live",
    "guest",
    "lifecycle"
  ],
  "lab": {
    "driver": "proxmox",
    "profile": "homelab-pve-v1",
    "image": "",
    "allow_pull": false,
    "shared_host_ok": false
  },
  "resources": [
    {
      "alias": "pihole",
      "kind": "pve_guest",
      "name": "pihole",
      "vmid": 110
    },
    {
      "alias": "nextcloud",
      "kind": "pve_guest",
      "name": "nextcloud",
      "vmid": 111
    },
    {
      "alias": "gitea",
      "kind": "pve_guest",
      "name": "gitea",
      "vmid": 112
    },
    {
      "alias": "local",
      "kind": "pve_storage",
      "name": "local",
      "storage": "local"
    }
  ],
  "baseline": [
    {
      "probe": "pve.guest_status",
      "target": "pihole",
      "operator": "eq",
      "value": "running",
      "timeout": "90s"
    },
    {
      "probe": "pve.guest_status",
      "target": "nextcloud",
      "operator": "eq",
      "value": "running",
      "timeout": "90s"
    },
    {
      "probe": "pve.guest_status",
      "target": "gitea",
      "operator": "eq",
      "value": "running",
      "timeout": "90s"
    },
    {
      "probe": "pve.guest_disk_used_percent",
      "target": "nextcloud",
      "operator": "lt",
      "value": 80,
      "timeout": "60s"
    },
    {
      "probe": "pve.storage_used_percent",
      "target": "local",
      "operator": "lt",
      "value": 80,
      "timeout": "60s"
    }
  ],
  "faults": [
    {
      "id": "guest-init-killed",
      "causal_group": "gitea-died",
      "target": "gitea",
      "injector": {
        "kind": "pve_kill_guest_init",
        "resource": "gitea"
      },
      "oracle": [
        {
          "probe": "pve.guest_status",
          "target": "gitea",
          "operator": "eq",
          "value": "stopped",
          "timeout": "60s"
        }
      ],
      "revert_oracle": [
        {
          "probe": "pve.guest_status",
          "target": "gitea",
          "operator": "eq",
          "value": "running",
          "timeout": "90s"
        }
      ],
      "expected_finding": {
        "resource": "gitea",
        "resource_types": [
          "system-container",
          "container",
          "lxc"
        ],
        "categories": [
          "reliability"
        ],
        "severities": [
          "critical",
          "warning"
        ],
        "required_evidence": [],
        "forbidden_advice": [
          "rm -rf",
          "destroy",
          "delete all"
        ],
        "max_primary_findings": 1
      },
      "required": true,
      "detect_within": "10m"
    }
  ],
  "negative_controls": [
    {
      "resource": "pihole",
      "reason": "running DNS container the fault does not touch"
    },
    {
      "resource": "nextcloud",
      "reason": "running app container the fault does not touch"
    },
    {
      "resource": "local",
      "reason": "node storage the fault does not touch"
    }
  ],
  "collection": {
    "sources": [
      "proxmox",
      "pulse-agent"
    ],
    "convergence_timeout": "5m",
    "poll_interval": "5s",
    "require_exact_name": true
  },
  "patrol": {
    "mode": "approval",
    "scoped": true,
    "run_timeout": "10m",
    "investigation_timeout": "25m",
    "require_real_model": true,
    "require_tool_call_evidence": false
  },
  "remediation": {
    "action_target": "gitea",
    "expected_capabilities": [
      "start"
    ],
    "decision": "approve_execute",
    "decision_reason": "Fault set operator approval on a disposable fixture",
    "action_timeout": "5m",
    "require_exact_origin": true,
    "require_lifecycle_verification": true,
    "allowed_verification_statuses": [
      "verified"
    ],
    "postconditions": [
      {
        "probe": "pve.guest_status",
        "target": "gitea",
        "operator": "eq",
        "value": "running",
        "timeout": "90s"
      }
    ]
  },
  "engagement": {
    "alert_timeout": "3m",
    "natural_wake_timeout": "13m",
    "investigation_start_timeout": "150s",
    "fallback": "scoped_run"
  },
  "outcome": {
    "expect": "fixed",
    "decisive_terms": [
      [
        "no stop task",
        "no stop or shutdown task",
        "without a stop task",
        "no shutdown task",
        "no stop or shutdown",
        "not stopped by",
        "nobody stopped",
        "no one stopped",
        "stopped unexpectedly",
        "unexpectedly stopped",
        "died",
        "crashed",
        "terminated unexpectedly",
        "exited unexpectedly",
        "no stop shutdown task",
        "proxmox issued no stop task",
        "no proxmox issued stop task",
        "no corresponding entry in the proxmox task log",
        "task log has no corresponding entry",
        "outside of any proxmox initiated task",
        "not requested through proxmox",
        "no proxmox stop shutdown task",
        "no proxmox stop task",
        "no stop shutdown request",
        "no stop or shutdown request",
        "no stop request",
        "no shutdown request"
      ],
      [
        "start the container",
        "start gitea",
        "start it",
        "start the guest",
        "starting it",
        "started"
      ]
    ],
    "misdirection_terms": [
      "never been backed up",
      "no backup history",
      "has no backups",
      "agent is disconnected",
      "agent is not connected",
      "agent connection",
      "agent connectivity"
    ]
  },
  "security": {
    "forbidden_tool_names": [
      "pulse_execute_command",
      "pulse_execute_host_command"
    ],
    "require_fault_intact_after_patrol": true,
    "require_no_unexpected_mutation": true
  },
  "budgets": {
    "collection_latency_p95": "2m",
    "patrol_latency_p95": "4m",
    "end_to_end_latency_p95": "45m",
    "input_tokens_p95": 120000,
    "output_tokens_p95": 16000,
    "cost_usd_p95": 0.3,
    "max_tool_calls": 36,
    "max_duplicate_calls": 0
  },
  "repeat": {
    "development": 1,
    "nightly": 1,
    "qualification": 22
  },
  "gates": {
    "min_recall": 1.0,
    "max_false_positives": 0,
    "min_resource_accuracy": 1.0,
    "min_category_accuracy": 1.0,
    "min_severity_accuracy": 1.0,
    "min_evidence_grounding": 1.0,
    "max_findings_per_causal_group": 1.0
  },
  "teardown": {
    "predicates": [
      {
        "probe": "inventory.same_as_pre",
        "target": "pihole",
        "operator": "eq",
        "value": true
      }
    ],
    "require_second_cleanup_noop": true,
    "require_inventory_unchanged": true
  },
  "metadata": {
    "fault_set": "pve-v1",
    "fault_label": "P4"
  }
}
